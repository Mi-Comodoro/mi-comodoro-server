{
  "name": "mi-comodoro-server",
  "version": "1.0.0-beta",
  "description": "Finanzas personales y Hogar",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write src/**/*.ts",
    "build": "nest build && tsc-alias",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --bail --forceExit --coverage",
    "seed:categories": "ts-node -r tsconfig-paths/register src/scripts/seed-categories.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/core/config/database/typeorm.config.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/core/config/database/typeorm.config.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/core/config/database/typeorm.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mi-Comodoro/mi-comodoro-server.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mi-Comodoro/mi-comodoro-server/issues"
  },
  "homepage": "https://github.com/Mi-Comodoro/mi-comodoro-server#readme",
  "dependencies": {
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.18",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "^11.2.10",
    "argon2": "0.44.0",
    "axios": "1.21.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "date-fns": "4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.1",
    "fast-xml-parser": "^5.12.1",
    "firebase-admin": "14.5.1",
    "helmet": "8.1.0",
    "joi": "18.3.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.17.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/date-fns": "^2.6.3",
    "@types/express": "5.0.6",
    "@types/jest": "^29.5.14",
    "@types/ms": "2.1.0",
    "@types/node": "^25.9.9",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "overrides": {
    "@nestjs/common": {
      "file-type": "16.5.4"
    },
    "file-type": "16.5.4",
    "@tootallnate/once": "2.0.0",
    "http-proxy-agent": "7.0.2",
    "lodash": "^4.17.24"
  },
  "engines": {
    "node": ">=26.13 <27"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "pnpm lint",
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
