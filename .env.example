# Copia este archivo a .env y completa los valores. Nunca subas valores reales.
# Las marcadas "opcional" tienen un valor por defecto en el código.

# Aplicación
APP_NAME=mi-comodoro-server
APP_PORT=9000                      # opcional (por defecto 9000)
NODE_ENV=development               # development | production
APP_URL=http://localhost:9000      # URL pública del backend
SWAGGER_URL=http://localhost:9000/api-docs
FRONTEND_URL=http://localhost:3000 # una o varias URLs separadas por coma; obligatoria en production (lista blanca CORS)
TRUST_PROXY=                       # opcional: 'loopback' por defecto; número de saltos, true/false o lista de IP/CIDR

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Opcionales (ver docs/DATABASE.md para el dimensionamiento):
# DB_MIGRATIONS_RUN=true           # por defecto true fuera de producción; en producción las migraciones se corren con `pnpm migration:run`
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=
# DB_SLOW_QUERY_MS=1000
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# Autenticación
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Firebase Admin (cuenta de servicio)
FB_PROJECT_ID=
FB_CLIENT_EMAIL=
FB_PRIVATE_KEY=                    # entre comillas y con los saltos de línea como \n

# Política de datos personales (docs/LEGAL.md y docs/PRIVACY.md)
LEGAL_CONSENT_REQUIRED=false       # activar solo cuando la política v2 esté publicada
LEGAL_POLICY_VERSION=2.0
ACCOUNT_DELETION_RETENTION_DAYS=90 # días entre la solicitud de eliminación y el borrado permanente
ACCOUNT_PURGE_CRON=30 3 * * *      # cuándo corre el borrado permanente (por defecto, a diario 03:30)

# Beta cerrada (docs/BETA-ACCESS.md)
BETA_INVITE_REQUIRED=false         # activar cuando el dashboard y la landing estén desplegados: el registro exige invitación aprobada
